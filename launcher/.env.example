# Launcher .env template — copy to .env and fill in your cluster values.
# .env is gitignored (never committed). This is the documented shape only.
# All IPs/hosts are placeholders; keep only the ConnectX fabric interface names.

# --- Cluster topology (sanitized) ---
# Head node (rank 0) and worker (rank 1). Use the RoCE (ConnectX) IPs, not the
# management LAN IPs.
CLUSTER_NODES="<HEAD_ROCE_IP>,<WORKER_ROCE_IP>"
LOCAL_IP="<HEAD_ROCE_IP>"

# --- ConnectX fabric (internal only) ---
# The ConnectX-7 x0 interface is the inter-node RoCE/IB link. The management LAN
# (en*P*s7) is NOT used for NCCL.
IFACE="enp1s0f0np0"
IB_IF="rocep1s0f0"
IB_GID_INDEX=3
MASTER_PORT="29522"

# --- Container runtime ---
# podman (rootless) is required for this lane. The DeepSeek lane also uses podman.
CONTAINER_RT="podman"
CONTAINER_NAME="vllm_qwen38"
CONTAINER_NCCL_DEBUG="WARN"
CONTAINER_NCCL_IGNORE_CPU_AFFINITY="1"
COPY_HOSTS="<WORKER_ROCE_IP>"

# --- Model ---
MODEL_PATH="/models/orcarouter-qwen3.8-flash-next-uncensored-nvfp4"
SERVED_MODEL_NAME="qwen3.8-flash-next-uncensored"

# --- Serving ---
MAX_MODEL_LEN=262144       # native context (no YaRN — see README)
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
KV_CACHE_DTYPE=fp8
MTP_NUM_SPECULATIVE_TOKENS=3

# --- HF token (leave unset here; set in the real .env on the deploy node) ---
# CONTAINER_HF_TOKEN="hf_..."
